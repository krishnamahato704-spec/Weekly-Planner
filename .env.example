# Optional transcription provider key. Keep this on the server only.
GEMINI_API_KEY=""

# AI transcription remains disabled when this separate access code is missing.
# Set a random 32-256 character secret server-side and share it only with users
# allowed to use transcription. The frontend keeps entered codes in memory only.
TRANSCRIPTION_ACCESS_TOKEN=""

# Express public origin for same-origin request validation behind a proxy.
# Leave empty for local development. The hosted Worker uses its request origin.
APP_URL=""
